# TPA코리아용 — 이맥스 자체 서버(114.203.209.5, G드라이브 설치)용 — 복사: cp .env.partner.example .env
# 서버가 공인 IP 직접 보유 — 포트포워딩 불필요, 방화벽 인바운드 3001만 열면 됨
# 클라이언트 접속 URL: http://114.203.209.5:3001
# LDAP 미사용 거래처 — 아래 LDAP_* 블록은 그대로 주석 유지

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=do.hy824@gmail.com

PARTNER_ORG_SOURCE=mssql
PARTNER_COMPANY_NAME=TPA
PARTNER_COMPANY_EXTERNAL_CODE=TPA
# RDP(114.203.209.5:4405)로 접속해 확인 필요: 메신저 서버와 DB가 같은 호스트면
# localhost/127.0.0.1로 바꿀 수 있음. DB명·포트도 RDP 접속 후 확정.
PARTNER_MSSQL_SERVER=114.203.209.5
PARTNER_MSSQL_PORT=1433
PARTNER_MSSQL_DATABASE=
PARTNER_MSSQL_USER=sa
PARTNER_MSSQL_PASSWORD=
PARTNER_MSSQL_ENCRYPT=false
PARTNER_MSSQL_TRUST_CERT=true
PARTNER_DEFAULT_PASSWORD=123456

# 이 거래처는 LDAP 미사용 — 아래 블록 전부 비활성 상태 유지
# LDAP_ENABLED=true
# LDAP_URL=ldaps://ldap.csin.kr:636
# LDAP_BASE_DN=dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_BASE=cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_SEARCH_FILTER=(&(objectClass=posixAccount)(uid=%s)(!(shadowExpire=1)))
# LDAP_BIND_DN=uid=ldap_gw,cn=users,dc=ldap,dc=csin,dc=kr
# LDAP_BIND_PASSWORD=
# LDAP_EMAIL_DOMAIN=csin.kr
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_LOCAL_EXCEPTIONS=
